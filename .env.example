# wanderlearn-field-reporter — environment variables.
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is committed.
# Provisioning checklist: plans/user-tasks/01-provision-env-keys.md

# --- LLM ---
# Seven providers are supported. The capture form's picker chooses which one
# powers a run (PRD App. A — operator A/B comparison). The /admin/models
# dashboard picks the model id each provider uses, plus a run-default.
#
#   FREE (rate-limited, $0):
#     OLLAMA       - local, no API key, just a reachable base URL.
#     CEREBRAS     - hosted free tier, Llama 3.3 70B, daily quota.
#     OPENROUTER   - hosted free models (DeepSeek, Qwen, Llama variants).
#     MISTRAL      - hosted free tier, 1B tokens/month.
#     TOGETHER     - hosted free tier, Llama 3.3 70B Turbo.
#
#   PAID (per-token billing):
#     ANTHROPIC    - Claude Sonnet 4.6 / Opus 4.7 / Haiku 4.5.
#     GOOGLE       - Gemini 2.5 Pro / Flash.
#
# At least one credential (or local Ollama) is required to run the graph.

# Paid (Claude / Gemini).
ANTHROPIC_API_KEY=            # https://console.anthropic.com/settings/keys
GEMINI_API_KEY=               # https://aistudio.google.com/apikey

# Free hosted tiers — sign up, paste keys.
CEREBRAS_API_KEY=             # https://cloud.cerebras.ai
OPENROUTER_API_KEY=           # https://openrouter.ai/keys
MISTRAL_API_KEY=              # https://console.mistral.ai
TOGETHER_API_KEY=             # https://api.together.ai/settings/api-keys

# Local Ollama (no key). Override if running on a non-default host.
OLLAMA_BASE_URL=http://localhost:11434

# Force a provider for runs that don't carry one in their request body
# (e.g. background jobs). Optional; falls back to the admin-stored default.
FIELD_REPORTER_LLM_PROVIDER=

# Comma-separated fallback chain when the primary throws. Leave UNSET on dev
# workstations and during operator A/B compare — that keeps each run pinned
# to one provider so the rubric scores are honest. Set on the deployed
# instance where reliability beats comparison purity, e.g.
# `openrouter,anthropic`.
FIELD_REPORTER_FALLBACK_PROVIDERS=

# --- Web search (Day 3 — the webSearch tool; leave blank until then) ---
# Tavily key for the webSearch tool. The free tier is sufficient.
TAVILY_API_KEY=               # https://app.tavily.com

# --- Observability (optional — the app runs fine with these unset) ---
# Tracing is on by default. With no LANGSMITH_API_KEY the LangChain SDK simply
# skips trace export — nothing breaks.
LANGSMITH_API_KEY=            # https://smith.langchain.com/settings
LANGSMITH_PROJECT=wanderlearn-field-reporter
LANGSMITH_TRACING=true

# --- Database (Day 1 schema generates offline; db:migrate / db:push need this) ---
# Neon Postgres. The Vercel Marketplace integration injects these STORAGE_-prefixed
# vars: STORAGE_DATABASE_URL is the pooled connection the app uses at runtime;
# STORAGE_DATABASE_URL_UNPOOLED is the direct connection drizzle-kit uses for
# migrations. Locally the two can hold the same value.
STORAGE_DATABASE_URL=          # https://console.neon.tech  (pooled connection string)
STORAGE_DATABASE_URL_UNPOOLED= # https://console.neon.tech  (direct / unpooled string)

# --- Storage (Day 3 — the cloudinaryMetadata tool; leave blank until then) ---
# Existing Wanderlearn Cloudinary tenant: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=               # https://console.cloudinary.com

# --- Auth (email-link sign-in — the operator console is single-user) ---
# Signing key for the session JWT and the magic-link token. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
# The ONE address allowed to sign in; every other email is silently rejected.
ADMIN_EMAIL=
# `From:` header on the sign-in email — must be a sender Mailgun authorizes.
EMAIL_FROM=
# Mailgun sending domain and private API key (HTTP API; no SMTP needed).
MAILGUN_DOMAIN=               # e.g. mg.witus.online
MAILGUN_API_KEY=              # https://app.mailgun.com — Sending → Domain settings

# --- WitUS SSO — "Sign in with WitUS" (ecosystem OIDC, code + PKCE flow) ---
# When WITUS_OIDC_CLIENT_ID is set, a "Sign in with WitUS" button appears on
# /signin. It authenticates via accounts.witus.online, then mints THIS app's own
# session (the same wlfr_session cookie the magic link sets) — and enforces the
# SAME single-admin gate: only ADMIN_EMAIL may sign in. Register the redirect URI
#   <NEXT_PUBLIC_SITE_URL>/api/auth/witus/callback
# with the WitUS IdP for this app's client. Leave blank to hide the button.
WITUS_OIDC_CLIENT_ID=
WITUS_OIDC_CLIENT_SECRET=
# Optional endpoint overrides — each defaults to accounts.witus.online/api/idp/oauth2/*
# WITUS_OIDC_AUTHORIZE_URL=
# WITUS_OIDC_TOKEN_URL=
# WITUS_OIDC_USERINFO_URL=
# Canonical public origin used to build the OIDC redirect_uri (must match what the
# IdP has registered). Falls back to the request origin when unset.
NEXT_PUBLIC_SITE_URL=          # e.g. https://field-reporter.witus.online

# WitUS Inbox — triage queue receiver. Optional locally; skipped if unset.
INBOX_INGEST_URL=https://inbox.witus.online/api/ingest
INBOX_INGEST_SECRET=
INBOX_SOURCE_SLUG=wanderlearn-field-reporter

# --- WitUS ecosystem: Outbox (outbound social drafts -> BAM accounts) ---
OUTBOX_INGEST_URL=https://outbox.witus.online/api/ingest
OUTBOX_SOURCE_SLUG=wanderlearn-field-reporter
OUTBOX_INGEST_SECRET=
OUTBOX_TRIGGER_ENABLED=true
