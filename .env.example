# wanderlearn-field-reporter — environment variables.
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is committed.
# Provisioning checklist: plans/user-tasks/01-provision-env-keys.md

# --- LLM (required to run the agent) ---
# Anthropic API key — Claude Sonnet 4.6 powers research / outline / write /
# generateImagePrompts. Create one at:
ANTHROPIC_API_KEY=            # https://console.anthropic.com/settings/keys

# --- Web search (Day 3 — the webSearch tool; leave blank until then) ---
# Tavily key for the webSearch tool. The free tier is sufficient.
TAVILY_API_KEY=               # https://app.tavily.com

# --- Observability (optional — the app runs fine with these unset) ---
# Tracing is on by default. With no LANGSMITH_API_KEY the LangChain SDK simply
# skips trace export — nothing breaks.
LANGSMITH_API_KEY=            # https://smith.langchain.com/settings
LANGSMITH_PROJECT=wanderlearn-field-reporter
LANGSMITH_TRACING=true

# --- Database (Day 1 schema generates offline; db:migrate / db:push need this) ---
# Neon Postgres connection string.
DATABASE_URL=                 # https://console.neon.tech  (project -> Connection string)

# --- Storage (Day 3 — the cloudinaryMetadata tool; leave blank until then) ---
# Existing Wanderlearn Cloudinary tenant: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=               # https://console.cloudinary.com
